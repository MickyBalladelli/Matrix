{
  "name": "@mickyballadelli/matrix",
  "version": "0.1.0-alpha.1",
  "description": "Tiny fine-grained reactive JavaScript framework with an optional JSX runtime",
  "type": "module",
  "license": "MIT",
  "author": "Micky Balladelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MickyBalladelli/Matrix.git"
  },
  "homepage": "https://github.com/MickyBalladelli/Matrix#readme",
  "bugs": {
    "url": "https://github.com/MickyBalladelli/Matrix/issues"
  },
  "keywords": [
    "reactive",
    "signals",
    "frontend",
    "jsx",
    "ui"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@12.0.2",
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 88",
    "Edge >= 90",
    "Safari >= 15",
    "ios_saf >= 15",
    "and_chr >= 90"
  ],
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "files": [
    "types",
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build && node scripts/check-package.mjs",
    "create-app": "node create-matrix-app/index.js",
    "size": "node scripts/size.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/run-browser-tests.mjs",
    "test:browser:official-examples": "node test/run-browser-tests.mjs --fixture test/official-examples.browser.html",
    "test:browser:extensions": "node test/run-browser-tests.mjs --fixture test/extension-patterns.browser.html",
    "test:browser:compat": "node test/run-browser-tests.mjs --fixture test/browser-compatibility.browser.html",
    "test:browser:security": "node test/run-browser-tests.mjs --fixture test/security.browser.html",
    "test:browser:dark": "node test/run-browser-tests.mjs --color-scheme dark --fixture test/browser-compatibility.browser.html",
    "test:browser:ios": "node test/run-browser-tests.mjs --browser webkit --device \"iPhone 13\" --fixture test/browser-compatibility.browser.html",
    "test:browser:android": "node test/run-browser-tests.mjs --browser chromium --device \"Pixel 5\" --fixture test/browser-compatibility.browser.html",
    "test:browser:edge": "node test/run-browser-tests.mjs --browser chromium --channel msedge --fixture test/browser-compatibility.browser.html",
    "test:node:compat": "node scripts/check-node-compatibility.mjs",
    "test:build:integrations": "node scripts/check-build-integrations.mjs",
    "test:runtime:bun": "bun run test/runtime-compatibility/basic.mjs",
    "test:runtime:deno": "deno run --allow-read test/runtime-compatibility/basic.mjs",
    "test:runtime:cloudflare": "wrangler dev --local --config test/runtime-compatibility/wrangler.toml",
    "test:performance": "node scripts/check-performance.mjs",
    "test:types": "tsc -p tsconfig.json",
    "test:package": "node scripts/package-smoke.mjs",
    "bench": "node bench/reactivity.js",
    "bench:memory": "node --expose-gc bench/memory.js",
    "bench:compare": "node bench/compare.mjs",
    "bench:record": "node bench/record-performance.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm run verify:release"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./reactivity": {
      "types": "./types/reactivity.d.ts",
      "import": "./dist/src/reactivity/index.js",
      "default": "./dist/src/reactivity/index.js"
    },
    "./components": {
      "types": "./types/components.d.ts",
      "import": "./dist/src/components/index.js",
      "default": "./dist/src/components/index.js"
    },
    "./dom": {
      "types": "./types/dom.d.ts",
      "import": "./dist/src/dom/index.js",
      "default": "./dist/src/dom/index.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "import": "./dist/src/jsx-runtime.js",
      "default": "./dist/src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./types/jsx-dev-runtime.d.ts",
      "import": "./dist/src/jsx-dev-runtime.js",
      "default": "./dist/src/jsx-dev-runtime.js"
    },
    "./styles": {
      "types": "./types/styles.d.ts",
      "import": "./dist/src/styles/index.js",
      "default": "./dist/src/styles/index.js"
    },
    "./utils": {
      "types": "./types/utils.d.ts",
      "import": "./dist/src/utils/index.js",
      "default": "./dist/src/utils/index.js"
    },
    "./plugins": {
      "types": "./types/plugins.d.ts",
      "import": "./dist/src/plugins.js",
      "default": "./dist/src/plugins.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
